# Template for rag_service/.env (gitignored). Placeholders only - never put a
# real key in this file. Every variable is optional except GROQ_API_KEY, which
# /ready and (later) answer generation need.

# Groq API key.
GROQ_API_KEY=your_groq_api_key_here

# Groq model id for answer generation. Availability depends on your Groq
# account: GET /ready confirms it against the models the key can see.
GROQ_MODEL=openai/gpt-oss-120b

# Embedding model. Only all-MiniLM-L6-v2 is supported (Chroma's built-in ONNX
# model, which runs without torch).
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Persistent Chroma directory. Relative paths resolve against rag_service/.
CHROMA_PATH=.chroma

# Chunking, in characters. The embedding model reads at most 256 tokens;
# 1000 characters stays within that for 99.5% of chunks.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Passages retrieved per question.
TOP_K=4

# Bind address for `python -m app`.
API_HOST=127.0.0.1
API_PORT=8000

# Timeout for outbound calls to Groq, in seconds.
REQUEST_TIMEOUT_SECONDS=30

# Who may wipe the corpus with DELETE /corpus. Leave unset to allow loopback
# callers only; true allows anyone (e.g. a CI container); false disables it.
# ALLOW_RESET=